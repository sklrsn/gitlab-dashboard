[Unit]
Description=GitLab pipeline dashboard
Documentation=file:///usr/local/share/doc/gitlab-dashboard/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gitlab-dashboard
Group=gitlab-dashboard
EnvironmentFile=/etc/gitlab-dashboard/env
ExecStart=/usr/local/bin/gitlab-dashboard serve
Restart=always
RestartSec=5
# Created and owned by the service user; used for local state from v2 on.
StateDirectory=gitlab-dashboard
StateDirectoryMode=0700

# Allow binding to ports below 1024 (e.g. LISTEN_ADDR=:443) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
