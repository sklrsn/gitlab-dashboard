# gitlab-dashboard configuration. Keep this file readable only by root (chmod 600).

# --- Required ---------------------------------------------------------------
# Your self-hosted GitLab.
GITLAB_URL=https://gitlab.example.com
# Token with read_api scope, on a user/bot with at least Reporter role.
# Prefer GITLAB_TOKEN_FILE (systemd credential / Docker secret) over GITLAB_TOKEN.
GITLAB_TOKEN=
#GITLAB_TOKEN_FILE=/run/secrets/gitlab_token

# --- Optional ---------------------------------------------------------------
# Extra CA certificate(s) (PEM) for a GitLab signed by an internal CA.
#GITLAB_CA_FILE=/etc/gitlab-dashboard/internal-ca.pem

# Where to listen. Default :8080.
#LISTEN_ADDR=:8080

# Serve HTTPS directly (VM without a reverse proxy). Set both or neither.
#TLS_CERT_FILE=/etc/gitlab-dashboard/tls.crt
#TLS_KEY_FILE=/etc/gitlab-dashboard/tls.key

# Logo shown left of the group/project name in the title bar (PNG, SVG, ...).
#LOGO_FILE=/etc/gitlab-dashboard/logo.svg

# What the page shows when no group/project is in the URL.
#DEFAULT_SCOPE=group:platform
#DEFAULT_SCOPE=project:platform/api

# Group view: how many of the most recently active projects to read. Default 50.
#GROUP_FANOUT_LIMIT=50
# How long GitLab answers are reused across viewers. Default 10s.
#CACHE_TTL=10s
# Timeout for each GitLab API call. Default 20s.
#GITLAB_TIMEOUT=20s
